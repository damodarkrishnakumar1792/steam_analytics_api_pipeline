[0m17:13:33.486323 [debug] [Thread-5 (]: On model.dbt_steam_api.mart_valve_recommendations: /* {"app": "dbt", "dbt_version": "1.11.12", "dbt_databricks_version": "1.12.1", "databricks_sql_connector_version": "4.2.6", "profile_name": "databricks_free", "target_name": "dev", "invocation_id": "40dbea60-21f5-41c6-855d-bb678d68c491", "node_id": "model.dbt_steam_api.mart_valve_recommendations"} */

  
    
        create or replace table `workspace`.`raw_steam_marts`.`mart_valve_recommendations`
      
      
    using delta
  
      
      
      
      
      
      
      
      
      as
      WITH genre_analysis AS (
    SELECT
        genre,
        COUNT(DISTINCT appid) AS game_count,
        ROUND(AVG(price), 2) AS avg_price,
        ROUND(AVG(estimated_owners), 0) AS avg_owners,
        ROUND(AVG(avg_playtime_minutes), 0) AS avg_playtime,
        ROUND(AVG(discount), 0) AS avg_discount,
        ROUND(AVG(peak_concurrent_users), 0) AS avg_peak_ccu,
        SUM(CASE WHEN success_category = 'Hit' THEN 1 ELSE 0 END) AS hit_count,
        ROUND(
            SUM(CASE WHEN success_category = 'Hit' THEN 1 ELSE 0 END) * 100.0 / COUNT(*),
            2
        ) AS hit_rate_pct
    FROM `workspace`.`raw_steam_staging`.`bridge_game_genres`
    WHERE genre IS NOT NULL AND genre != ''
    GROUP BY genre
),

tag_analysis AS (
    SELECT
        tag,
        COUNT(DISTINCT appid) AS game_count,
        ROUND(AVG(estimated_owners), 0) AS avg_owners,
        ROUND(AVG(avg_playtime_minutes), 0) AS avg_playtime,
        ROUND(AVG(price), 2) AS avg_price
    FROM `workspace`.`raw_steam_staging`.`bridge_game_tags`
    GROUP BY tag
    HAVING COUNT(DISTINCT appid) >= 5
),

price_analysis AS (
    SELECT
        price_tier,
        COUNT(*) AS game_count,
        ROUND(AVG(estimated_owners), 0) AS avg_owners,
        ROUND(AVG(avg_playtime_minutes), 0) AS avg_playtime,
        ROUND(AVG(discount), 0) AS avg_discount,
        SUM(CASE WHEN success_category IN ('Hit', 'Successful') THEN 1 ELSE 0 END) AS successful_count,
        ROUND(
            SUM(CASE WHEN success_category IN ('Hit', 'Successful') THEN 1 ELSE 0 END) * 100.0 / COUNT(*),
            2
        ) AS success_rate_pct
    FROM `workspace`.`raw_steam_staging`.`fct_game_performance`
    GROUP BY price_tier
),

engagement_analysis AS (
    SELECT
        engagement_tier,
        COUNT(*) AS game_count,
        ROUND(AVG(price), 2) AS avg_price,
        ROUND(AVG(discount), 0) AS avg_discount,
        ROUND(AVG(peak_concurrent_users), 0) AS avg_peak_ccu
    FROM `workspace`.`raw_steam_staging`.`fct_game_performance`
    GROUP BY engagement_tier
),

language_analysis AS (
    SELECT
        language,
        COUNT(DISTINCT appid) AS game_count,
        ROUND(AVG(estimated_owners), 0) AS avg_owners,
        ROUND(AVG(avg_playtime_minutes), 0) AS avg_playtime,
        ROUND(AVG(price), 2) AS avg_price,
        SUM(CASE WHEN success_category IN ('Hit', 'Successful') THEN 1 ELSE 0 END) AS successful_count,
        ROUND(
            SUM(CASE WHEN success_category IN ('Hit', 'Successful') THEN 1 ELSE 0 END) * 100.0 / COUNT(*),
            2
        ) AS success_rate_pct
    FROM `workspace`.`raw_steam_staging`.`bridge_game_languages`
    WHERE language IS NOT NULL AND language != ''
    GROUP BY language
    HAVING COUNT(DISTINCT appid) >= 5
),

localization_analysis AS (
    SELECT
        CASE 
            WHEN language_count >= 10 THEN 'Heavily Localized (10+)'
            WHEN language_count >= 5 THEN 'Moderately Localized (5-9)'
            WHEN language_count >= 2 THEN 'Basic Localization (2-4)'
            ELSE 'Single Language'
        END AS localization_tier,
        COUNT(*) AS game_count,
        ROUND(AVG(estimated_owners), 0) AS avg_owners,
        ROUND(AVG(avg_playtime_minutes), 0) AS avg_playtime,
        ROUND(AVG(price), 2) AS avg_price,
        SUM(CASE WHEN success_category IN ('Hit', 'Successful') THEN 1 ELSE 0 END) AS successful_count,
        ROUND(
            SUM(CASE WHEN success_category IN ('Hit', 'Successful') THEN 1 ELSE 0 END) * 100.0 / COUNT(*),
            2
        ) AS success_rate_pct
    FROM (
        SELECT 
            appid,
            estimated_owners,
            avg_playtime_minutes,
            price,
            success_category,
            COUNT(DISTINCT language) AS language_count
        FROM `workspace`.`raw_steam_staging`.`bridge_game_languages`
        GROUP BY appid, estimated_owners, avg_playtime_minutes, price, success_category
    )
