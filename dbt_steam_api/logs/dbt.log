        create or replace table `workspace`.`raw_steam_staging`.`bridge_game_genres`
      
      
    using delta
  
      
      
      
      
      
      
      
      
      as
      WITH exploded AS (
    SELECT
        appid,
        game_name,
        estimated_owners,
        avg_playtime_minutes,
        price,
