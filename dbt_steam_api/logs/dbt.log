    game_name,
    genre,
    estimated_owners,
    avg_playtime_minutes,
    price,
    success_category,
    COUNT(*) OVER (PARTITION BY genre) AS games_in_genre
FROM exploded
WHERE genre IS NOT NULL AND genre != ''
  
