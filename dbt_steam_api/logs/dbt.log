[0m16:33:24.389118 [debug] [Thread-5 (]: On model.dbt_steam_api.stg_steam_apps: /* {"app": "dbt", "dbt_version": "1.11.12", "dbt_databricks_version": "1.12.1", "databricks_sql_connector_version": "4.2.6", "profile_name": "databricks_free", "target_name": "dev", "invocation_id": "517a1d9f-5ead-418e-ae1a-55e82a4fde6d", "node_id": "model.dbt_steam_api.stg_steam_apps"} */

  
  
  
  create or replace view `workspace`.`raw_steam_staging`.`stg_steam_apps`
  
  as (
    WITH parsed AS (
    SELECT
        appid,
        TRIM(name) AS game_name,
        TRIM(developer) AS developer,
        TRIM(publisher) AS publisher,
        score_rank,
        owners,
        average_forever AS avg_playtime_minutes,
        average_2weeks AS avg_playtime_2weeks,
        median_forever AS median_playtime_minutes,
        median_2weeks AS median_playtime_2weeks,
        ccu AS peak_concurrent_users,
        price,
        initialprice AS original_price,
        discount,
        tags,
        languages,
        genre,

        -- Parse owners range into min/max
        CAST(SPLIT_PART(owners, '-', 1) AS BIGINT) AS owners_min,
        CAST(SPLIT_PART(owners, '-', 2) AS BIGINT) AS owners_max,

        -- Calculate derived metrics
        ROUND((CAST(SPLIT_PART(owners, '-', 1) AS BIGINT) + CAST(SPLIT_PART(owners, '-', 2) AS BIGINT)) / 2, 0) AS estimated_owners,

        -- Price categories
        CASE 
            WHEN price = 0 THEN 'Free'
            WHEN price <= 10 THEN 'Budget ($0-10)'
            WHEN price <= 30 THEN 'Mid-tier ($10-30)'
            WHEN price <= 60 THEN 'Premium ($30-60)'
            ELSE 'AAA ($60+)'
        END AS price_tier,

        -- Engagement categories
        CASE
            WHEN average_forever < 60 THEN 'Casual (<1h)'
            WHEN average_forever < 600 THEN 'Moderate (1-10h)'
            WHEN average_forever < 3000 THEN 'Engaged (10-50h)'
            ELSE 'Hardcore (50h+)'
        END AS engagement_tier,

        -- Discount flag
        CASE WHEN discount > 0 THEN TRUE ELSE FALSE END AS is_discounted,

        -- Parse tags into array for analysis
        SPLIT(tags, ',') AS tag_list,

        -- Parse languages
        SPLIT(languages, ',') AS language_list,

        -- Parse genres
        SPLIT(genre, ',') AS genre_list,

        -- Success indicators
        CASE 
            WHEN (CAST(SPLIT_PART(owners, '-', 1) AS BIGINT) + CAST(SPLIT_PART(owners, '-', 2) AS BIGINT)) / 2 > 1000000 AND average_forever > 600 THEN 'Hit'
            WHEN (CAST(SPLIT_PART(owners, '-', 1) AS BIGINT) + CAST(SPLIT_PART(owners, '-', 2) AS BIGINT)) / 2 > 100000 THEN 'Successful'
            WHEN (CAST(SPLIT_PART(owners, '-', 1) AS BIGINT) + CAST(SPLIT_PART(owners, '-', 2) AS BIGINT)) / 2 > 10000 THEN 'Moderate'
            ELSE 'Niche'
        END AS success_category

    FROM `workspace`.`raw_steam`.`raw_apps`
    WHERE name IS NOT NULL AND name != ''
)

SELECT * FROM parsed
  )

